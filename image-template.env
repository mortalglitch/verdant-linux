# Here we set a bunch of parameters for your image build

# output image name
IMAGE_NAME=umbrielblue

# github username (metadata labels only — builds run locally)
REPO_ORGANIZATION="mortalglitch"

IMAGE_DESC="Custom bootc image: Umbriel + Noctalia on silverblue:44, LazyVim, ghostty, btop, starship, ocr-region, Homebrew (baked, Bluefin pattern), Flatpak + Bazaar"
IMAGE_KEYWORDS="bootc,oci,linux,umbriel,noctalia"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="44"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
