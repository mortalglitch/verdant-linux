# Baked copy of the Terra repo, MODIFIED from the upstream file:
# gpgcheck/repo_gpgcheck set to 0 because bootc-image-builder's manifest
# step runs dnf in a context where file:// GPG keys from the image's /etc
# are unreadable, and dnf5 does NOT honor /etc/dnf/repos.override.d
# (dnf4-only feature). Packages are GPG-verified during the container
# build, where the key IS readable. Revert to gpgcheck=1 if you never
# build ISOs with bootc-image-builder.

[terra]
name=Terra $releasever
#baseurl=https://repos.fyralabs.com/terra$releasever
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
repo_gpgcheck=0
# DISABLED at build time: the Terra layer ships pinned via vendored_rpms/
# (see pins.toml). The live nightly repo is a moving target and re-enabling it
# would let an installed system drift from the pinned ostree commit. Re-enable
# only to user-layer a Terra package that isn't in the pin.
enabled=0
enabled_metadata=0
countme=1

[terra-source]
name=Terra $releasever - Source
#baseurl=https://repos.fyralabs.com/terra$releasever-source
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever-source&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever-source
repo_gpgcheck=0
enabled=0
enabled_metadata=0
